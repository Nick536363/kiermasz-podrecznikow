<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * {
            text-align: center;
        }

        body {
            background-color: #5A9586;
        }
        td{
            border: 2px solid #9AD2D2;
            background-color: #D3F3F3;
        }
        th{
            border: 2px solid #9D99D2;
            background-color: #E2D4F3;
        }
        #info {
            border:3px solid #E2D4F3;
            background-color: #9AD2D2;
            width: 50%;
            margin-left: 25%;
        }
    </style>
    <title>Lista podręczników</title>
</head>
<body>
    <h1>Lista podręczników</h1>

    <table>
        <tr>
            <th>Tytuł książki</th>
            <th>Sprzedający uczeń</th>
            <th>Cena ucznia</th>
            <th>Prowizja</th>
            <th>Cena końcowa</th>
            <th>Stan</th>
            <th>Data dodania</th>
        </tr>
        <% books.forEach((book)=>{%>
        <tr>
            <td><%= book.title %></td>
            <td><%= book.pupil %></td>
            <td><%= book.pupil_price %></td>
            <td><%= book.commision %></td>
            <td><%= book.end_price %></td>
            <td><%= book.status %></td>
            <td><%= book.add_date %></td>
        </tr>
        <%});%>
    </table>
    <form method="get" action="/add">
        <button type="submit">Dodaj podręcznik</button>
    </form>
    <form method="get" action="/change">
        <button type="submit">Zmień podręcznik</button>
    </form>

    <div id="info">
        <h3>Liczba wszytkich książek: <%= sell_info.sum_books %></h3>
        <h3>Liczba sprzedanych książek: <%= sell_info.sold %></h3>
        <h3>Liczba niesprzedanych książek: <%= sell_info.non_sold %></h3>
        <h3>Otrzymano pieniędzy: <%= sell_info.money %> zł</h3>
        <h3>Całkowita prowizja: <%= sell_info.commision %> zł</h3>
    </div>
</body>
</html>