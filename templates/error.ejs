<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error!</title>

    <style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        text-align: center;
    }

    body {
        min-height: 100vh;
        padding: 40px 20px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        font-family: "Segoe UI", Arial, sans-serif;
        color: #263238;

        background: linear-gradient(
            135deg,
            #5a9586,
            #7db8a8,
            #a8d8cb
        );
    }

    h1 {
        margin-bottom: 20px;

        color: #ffffff;
        font-size: 42px;
        font-weight: 700;
        letter-spacing: 1px;

        text-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
    }

    body > div {
        width: min(600px, 90%);
        margin-bottom: 25px;
        padding: 25px 30px;

        border-radius: 18px;

        background: rgba(255, 255, 255, 0.85);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);

        backdrop-filter: blur(8px);
    }

    h3 {
        color: #345c54;
        font-size: 18px;
        font-weight: 500;
        line-height: 1.5;
    }

    button {
        height: 46px;
        padding: 0 24px;

        border: none;
        border-radius: 10px;

        background: #496f67;
        color: white;

        font-family: inherit;
        font-size: 16px;
        font-weight: 600;

        cursor: pointer;

        box-shadow: 0 5px 12px rgba(0, 0, 0, 0.15);

        transition: 0.25s ease;
    }

    button:hover {
        background: #365951;
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.2);
    }

    button:active {
        transform: translateY(0);
    }

    button:focus-visible {
        outline: 3px solid rgba(111, 106, 168, 0.35);
        outline-offset: 2px;
    }

    @media (max-width: 500px) {
        body {
            padding: 20px 10px;
        }

        h1 {
            font-size: 30px;
            text-transform: uppercase;
        }

        body > div {
            width: 95%;
            padding: 20px;
        }

        h3 {
            font-size: 16px;
        }

        button {
            width: 90%;
        }
    }
</style>


</head>
<body>
    <h1><%= title %></h1>
    <div>
        <h3><%= error %></h3>
    </div>
    <form method="get" action="/">
        <button type="submit">Wróć</button>
    </form>
</body>
</html>